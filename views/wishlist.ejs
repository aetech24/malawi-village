<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wishlist</title>
  <link rel="stylesheet" href="/css/wishlist.css">
  <script src="https://kit.fontawesome.com/6dc24a4f9f.js" crossorigin="anonymous"></script>
  <style>

  </style>
</head>
<body>
  <main>
    <!-- Favorites Section -->
    <section class="favorites-section">
      <h2>Favorites (<%= wishlistItems.length %>)</h2>
      <button class="move-all-btn">Move All to Cart</button>
      <div class="favorites-grid">
        <% if (wishlistItems.length > 0) { %>
          <% wishlistItems.forEach(item => { %>
            <div class="product-card">
              <img src="<%= item.image %>" alt="<%= item.name %>">
              <div class="product-details">
                <h3 class="product-name"><%= item.name %></h3>
                <p class="product-price">GH₵<%= item.price.big %></p>
                <button class="add-to-cart-btn" onclick="addToCart('<%= item.id %>')">Add to Cart</button>
              </div>
              <button class="remove-btn" onclick="removeFromWishlist('<%= item.id %>')">🗑</button>
            </div>
          <% }) %>
        <% } else { %>
          <p style="text-align:center;">Your wishlist is empty.</p>
        <% } %>
      </div>
  </main>
  <script src="/js/cart.js"></script>
  <script src="/js/wishlist.js"></script>

  <script>
    function removeFromWishlist(productId) {
      fetch('/wishlist/remove', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ productId: productId })
      }).then(response => {
        if (response.ok) {
          location.reload();
        } else {
          alert('Removed from wishlist');
        }
      });
    }
  </script>
</body>
</html>
