<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop</title>
  <script src="https://kit.fontawesome.com/6dc24a4f9f.js" crossorigin="anonymous"></script>
  <style>
    .price-btn {
      background-color: #f9f9f9;
      border: 1px solid #ddd;
      padding: 5px 10px;
      margin: 5px;
      cursor: pointer;
      border-radius: 4px;
    }

    .price-btn:hover {
      background-color: #e6e6e6;
    }

    .selected-price {
      margin-top: 10px;
      font-weight: bold;
      color: #333;
    }

    .add-to-cart {
      background-color: #28a745;
      color: white;
      border: none;
      padding: 10px 15px;
      cursor: pointer;
      border-radius: 4px;
      font-weight: bold;
    }

    .add-to-cart:hover {
      background-color: #218838;
    }

    .wishlist-btns {
      background: none;
      border: none;
      color: #e74c3c;
      cursor: pointer;
      font-size: 20px;
    }

    .wishlist-btns:hover {
      color: #c0392b;
    }
  </style>
</head>
<body>
<main>
  <h2>Malawi Village</h2>
  <p style="text-align: center; align-self:center; font-style:italic;">Tastes like a village</p>

  <!-- Category Buttons -->
  <div class="categories">
    <h2>Product Categories</h2>
    <div class="category-buttons">
      <a href="/shop?category=All">
        <button class="category-button <%= selectedCategory === 'All' ? 'active' : '' %>">All</button>
      </a>
      <a href="/shop?category=Refreshment">
        <button class="category-button <%= selectedCategory === 'Refreshment' ? 'active' : '' %>">Refreshments</button>
      </a>
      <a href="/shop?category=Detox and Immune booster">
        <button class="category-button <%= selectedCategory === 'Detox and Immune booster' ? 'active' : '' %>">Detox & Immune Boosters</button>
      </a>
      <a href="/shop?category=Sweet and unsweet tea">
        <button class="category-button <%= selectedCategory === 'Sweet and unsweet tea' ? 'active' : '' %>">Sweet & Unsweet Tea</button>
      </a>
    </div>
  </div>

  <!-- Products Display -->
  <% if (products && products.length > 0) { %>
    <div id="product-list" class="product-grid">
      <% products.forEach(product => { %>
        <div class="product-item">
          <div class="product_image">
            <a href="/singleproducts/<%= product.id %>">
              <img src="<%= product.image %>" alt="<%= product.name %>" class="product-img">
            </a>
            <button class="wishlist-btns" onclick="addToWishlist('<%= product.id %>', '<%= product.name %>', '<%= product.image %>', '<%= product.price.big %>', 'L')">&#x2661;</button>
          </div>
          <div class="product_details">
            <h3><%= product.name %></h3>
            <div class="product_price">
              <p>
                <button 
                  class="price-btn" 
                  data-price="<%= product.price.big %>" 
                  data-size="L"
                  onclick="displayPrice(this, '<%= product.id %>')">
                  Price (L): $<%= product.price.big || 'N/A' %>
                </button>
                <button 
                  class="price-btn" 
                  data-price="<%= product.price.small %>" 
                  data-size="S"
                  onclick="displayPrice(this, '<%= product.id %>')">
                  Price (S): $<%= product.price.small || 'N/A' %>
                </button>
              </p>
              <div class="selected-price">
                Selected Price: <span id="price-display-<%= product.id %>">N/A</span>
              </div>
            </div>
            <a href="javascript:void(0);" onclick="addToCart('<%= product.id %>')">
              <button class="add-to-cart">Add to Cart</button>
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <p class="no-products">No products to display in the "<%= selectedCategory %>" category. Please select another category above.</p>
  <% } %>
</main>

<script>
  const cart = {}; // A temporary object to store cart items

  function displayPrice(button, productId) {
    // Get the price and size from the data attributes
    const price = button.getAttribute("data-price");
    const size = button.getAttribute("data-size");

    // Update the corresponding price display element
    const priceDisplay = document.getElementById(`price-display-${productId}`);
    priceDisplay.textContent = `$${price}`;

    // Update the selected price and size in the cart object
    cart[productId] = { price, size };
  }

  function addToCart(productId) {
    // Get the selected price and size
    const selectedPrice = cart[productId]?.price;
    const selectedSize = cart[productId]?.size;

    if (!selectedPrice || !selectedSize) {
      alert("Please select a price and size before adding to cart.");
      return;
    }

    // Simulate adding the product to the cart
    console.log(`Product ${productId} added to cart with price $${selectedPrice} and size ${selectedSize}`);
    alert(`Product added to cart with price $${selectedPrice} and size ${selectedSize}`);

    // Add the product to the cart (this should be replaced with actual cart logic)
    fetch('/cart/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ id: productId, price: selectedPrice, size: selectedSize })
    }).then(response => response.json())
      .then(data => {
        console.log(data);
      });
  }

  function addToWishlist(productId, name, image, price, size) {
    fetch('/wishlist/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ id: productId, name, image, price, size })
    }).then(response => response.json())
      .then(data => {
        console.log(data);
        alert('Product added to wishlist');
      });
  }
</script>

<script src="/js/cart.js"></script>
</body>
</html>
<style>
  .add-to-cart {
    background-color: #ffd400;
    color: black;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: 5px;
    margin: 5px;
  }

  .add-to-cart:hover {
    opacity: 0.8;
  }
</style>
</body>
</html>