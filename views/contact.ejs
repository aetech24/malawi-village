<link rel="stylesheet" href="/css/contact.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<main>
  <h1>Get in Touch</h1>
  <p>If you have any questions, feel free to reach out to us! We're here to help.</p>
  
  <section>
    <!-- Contact Form Section -->
    <div class="contact_form">
      <h2 class="send-message">Send Us a Message</h2>
      <form action="" method="POST">
        <input type="text" name="name" placeholder="Your Full Name*" required>
        <input type="email" name="email" placeholder="Your Email Address*" required>
        <input type="text" name="phone" placeholder="Your Phone Number*" required>
        <textarea name="message" rows="6" placeholder="Your Message*" required></textarea>
        <div class="hub_btns">
          <button type="submit" class="btn contact_send">Send</button>
        </div>
      </form>
    </div>

    <!-- Contact Information Section -->
    <div class="contact_info">
      <h2 class="question">Have Some Questions for Us?</h2>
      <div class="info_item">
        <i class="fas fa-phone-alt"></i>
        <div>
          <h4>Phone Number</h4>
          <p>+233 248 9999</p>
        </div>
      </div>
      <div class="info_item">
        <i class="fas fa-envelope"></i>
        <div>
          <h4>Email</h4>
          <p><a href="mailto:malawivillage@gmail.com">malawivillage@gmail.com</a></p>
        </div>
      </div>
      <div class="info_item">
        <i class="fas fa-clock"></i>
        <div>
          <h4>Working Hours</h4>
          <p>Monday - Thursday</p>
        </div>
      </div>
    </div>
  </section>
</main>