<style>
  .add-to-cart-btn, .add-to-cart-btns {
    background-color: #ffd400;
    color: black;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: 5px;
    margin: 5px;
  }

  .add-to-cart-btn:hover, .add-to-cart-btns:hover {
    opacity: 0.8;
  }
  .hero-banner {
    position: relative;
    text-align: center;
    color: white;
  }
  .hero-banner img {
    opacity: 0.3;
  }

  /* Centered text */
.centered {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 100%;
}
  .centered h4 {
    font-size: 120px;
    background: rgba(0, 0, 0, 0.384);
    color: white;
  }
  .centered p {
    font-size: 30px;
    text-align: center;
    font-weight: 300;
    background: rgba(0, 0, 0, 0.384);
  }

  /* CTA area */
</style>