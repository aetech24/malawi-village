<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <script src="https://kit.fontawesome.com/6dc24a4f9f.js" crossorigin="anonymous"></script>
</head>
<body>
  
  <div class="hero_banner">
    <img src="/assets/hero-banner.jpg" alt="hero-img" style="opacity: 0.65;">
    <div class="centered">
      <h4>Malawi Village</h4>
      <p style="color: #ffd400; font-style:italic;">Every sip feels like spring</p>
    </div>
  </div>

  <!-- hero area ends here -->

  <!-- main body -->
   

   <!-- main ends here -->

   <!-- cta area bns gere-->
    <div class="cta_info">
      <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Maiores consectetur iste ipsum, soluta officia laboriosam,
        dolorum aspernatur facilis corporis nostrum exercitationem totam eum? Cumque assumenda asperiores commodi illum
        debitis maiores.</p>
    </div>


    <div class="cta_container">
      <div class="cta_content">
        <h2>Want 10% off your first order?</h2>
        <p>Enter your email below to <span>get 10%</span> <br> off your first order</p>
        <form action="">
          <input type="text" placeholder="Email Address">
          <button class="btn view_btn">Submit</button>
        </form>
      </div>
    </div>
  <%- include('flashsales')%>
    <!--View All button -->
    <div class="view-all-btn-container">
      <a href="/shop?category=All">
        <button class="view-all-btn">View All Products</button>
      </a>
    </div>
    <!-- banner -->
     <section>
     <div class="banner-container" style="background-image: url('<%= backgroundImage %>');">
    <div class="overlay"></div>
    <div class="banner-content">
      <a href="/shop">
      <h3 class="category-title">Categories</h3>
    </a>
      <h1 class="banner-title">Enjoy Your Favorite Juice<br>at low prices</h1>
      <a href="<%= buttonLink %>" class="buy-now-btn">Buy Now</a>
    </div>
    <div class="product-image-container">
      <img src="<%= productImage %>" alt="Juice" class="product-image">
    </div>
  </div>
</section>


<!--View all products grid-->

<div class="product-grid-container">
  <h2 class="section-title">Explore Our Products</h2>
  <div class="product-grid">
    <% gridProducts.forEach(gridProduct => { %>
      <div class="products-card">
        <div class="product-images-container">
          <img src="<%= gridProduct.image %>" alt="<%= gridProduct.name %>" class="product-images">
          <button class="wishlist-btns" onclick="addToWishlist('<%= gridProduct.id %>', '<%= gridProduct.name %>', '<%= gridProduct.image %>', '<%= gridProduct.price.big %>', 'L')">&#x2661;</button>
        </div>
        <div class="products-info">
          <p class="products-name"><%= gridProduct.name %></p>
          <p class="products-price">GH₵<%= gridProduct.price.toFixed(2) %></p>
          <a href="javascript:void(0);" onclick="addToCart('<%= gridProduct.id %>')">
            <button class="add-to-cart-btns" onclick="addToCart('<%= gridProduct.id %>')">Add to Cart</button>
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</div>
<script src="/js/cart.js"></script>
<script src="/js/wishlist.js"></script>
<script src="/routes/index.js"></script>
    <!-- advantage  -->

    <div class="gallery_container" style="margin-bottom: 25px;">
      <div class="gallery_text">
        <h2 class="main">Our Gallery</h2>
      </div>
    
      <div class="gallery_related_images">
        <div class="related_images">
          <img src="/assets/tes-img1.jpg" alt="" width="330px">
        </div>
        <div class="related_images">
          <img src="/assets/tes-img9.jpg" alt="">
        </div>
        <div class="related_images">
          <img src="/assets/tes-img2.jpg" alt="">
        </div>
        <div class="related_images">
          <img src="/assets/tes-img3.jpg" alt="">
        </div>
        <div class="related_images">
          <img src="/assets/tes-img4.jpg" alt="">
        </div>
        <div class="related_images">
          <img src="/assets/tes-img5.jpg" alt="">
        </div>
        <div class="related_images">
          <img src="/assets/tes-img6.jpg" alt="">
        </div>
        <div class="related_images">
          <img src="/assets/tes-img7.jpg" alt="">
        </div>
        <div class="related_images">
          <img src="/assets/tes-img8.jpg" alt="">
        </div>
      </div>
    </div>
  </main>

  <button onclick="topFunction()" id="scrollToTopBtn" title="Go to top">
    <i class="fas fa-arrow-up"></i>
  </button>

  <script>
    async function addToCart(productId) {
      // Add cart logic here
    }

    function addToWishlist(productId, name, image, price, size) {
      fetch('/wishlist/add', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ id: productId, name, image, price, size })
      }).then(response => response.json())
        .then(data => {
          console.log(data);
          alert('Product added to wishlist');
        });
    }

    // Scroll to top button
    var scrollToTopBtn = document.getElementById("scrollToTopBtn");

    window.onscroll = function() {
      scrollFunction();
    };

    function scrollFunction() {
      if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
        scrollToTopBtn.style.display = "block";
      } else {
        scrollToTopBtn.style.display = "none";
      }
    }

    function topFunction() {
      document.body.scrollTop = 0;
      document.documentElement.scrollTop = 0;
    }
  </script>
</body>
</html>
<style>
  .add-to-cart-btn, .add-to-cart-btns {
    background-color: #ffd400;
    color: black;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: 5px;
    margin: 5px;
  }

  .add-to-cart-btn:hover, .add-to-cart-btns:hover {
    opacity: 0.8;
  }
  .hero-banner {
    position: relative;
    text-align: center;
    color: white;
  }
  .hero-banner img {
    opacity: 0.3;
  }

  /* Centered text */
.centered {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 100%;
}
  .centered h4 {
    font-size: 120px;
    background: rgba(0, 0, 0, 0.384);
    color: white;
  }
  .centered p {
    font-size: 30px;
    text-align: center;
    font-weight: 300;
    background: rgba(0, 0, 0, 0.384);
  }

  /* CTA area */
  #scrollToTopBtn {
    display: none;
    position: fixed;
    bottom: 20px;
    right: 30px;
    z-index: 99;
    font-size: 18px;
    border: none;
    outline: none;
    background-color: #333;
    color: white;
    cursor: pointer;
    padding: 15px;
    border-radius: 50%;
  }

  #scrollToTopBtn:hover {
    background-color: #555;
  }
</style>